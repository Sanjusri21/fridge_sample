# ==========================================
# ALINA Smart Fridge Voice Assistant Config
# ==========================================

# Operating Mode (true = Simulation/Demo mode without ESP32, false = Real IoT mode)
DEMO_MODE=true

# ESP32 IoT Configuration
ESP32_IP=192.168.1.100
ESP32_PORT=80
ESP32_TIMEOUT=3.0

# Hardware & Vision Settings
CAMERA_INDEX=0
OCR_ENABLED=true
TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe

# Voice Configuration
VOICE_ENABLED=true
VOICE_RATE=160
VOICE_VOLUME=1.0

# AI Provider Configuration: none | gemini | openai
AI_PROVIDER=none
AI_API_KEY=

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=true
